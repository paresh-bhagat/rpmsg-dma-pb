        "output_size": "61680"
      }
    },
    {
      "stage_id": "tvm_inference",
      "service": "tvm",
      "message_type": "TVM_INFERENCE",
      "parameters": {
        "input_size": "1028"
      }
    },
    {
      "stage_id": "stft_synthesis",
      "service": "generic",
      "message_type": "C7X_MSG_ISTFT_SYNTHESIZE",
      "parameters": {
        "input_size": "61680",
        "output_size": "15380"
      }
    }
  ]
